{
	"name": "@scicave/math-latex-parser",
	"version": "3.0.3",
	"description": "A mathematical (La)TeX parser.",
	"main": "./index.js",
	"types": "./index.d.ts",
	"targets": {
		"web": {
			"source": "./src/browser-index.js",
			"distDir": "./lib",
			"context": "browser",
			"optimize": false,
			"outputFormat": "global"
		},
		"webMin": {
			"source": "./src/browser-index.js",
			"distDir": "./lib",
			"context": "browser",
			"optimize": true,
			"outputFormat": "global"
		}
	},
	"files": [
		"lib/",
		"CHANGELOG.md",
		"index.js",
		"index.d.ts",
		"LICENSE",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MuhammadSawalhy/math-latex-parser.git"
	},
	"bugs": {
		"url": "https://github.com/MuhammadSawalhy/math-latex-parser/issues"
	},
	"homepage": "https://github.com/MuhammadSawalhy/math-latex-parser#readme",
	"scripts": {
		"test": "jest",
		"lint": "eslint ./src/ --fix",
		"debug": "node debug.js",
		"start": "npm run build:watch",
		"build": "node build.js",
		"bundle": "npm run build && npm run test && parcel build --target web && mv ./lib/browser-index.js ./lib/bundle.js && parcel build --target webMin && mv ./lib/browser-index.js ./lib/bundle.min.js",
		"build:watch": "nodemon -w src -w build.js -e js,pegjs -x 'npm run build'",
		"debug:watch": "nodemon -w src -w build.js -e js,pegjs -x 'npm run build' -w debug.js -x 'npm run debug'",
		"test:watch": "npm t -- --watch"
	},
	"jest": {
		"verbose": true,
		"moduleNameMapper": {
			"parser": "<rootDir>/lib/index.js"
		}
	},
	"keywords": [
		"parser",
		"pegjs",
		"latex-parser",
		"math-parser",
		"math",
		"mathematics"
	],
	"author": "Muhammad Assawalhy",
	"license": "MIT",
	"devDependencies": {
		"eslint": "^7.8.1",
		"jest": "^26.4.2",
		"nodemon": "^2.0.4",
		"parcel": "^2.16.3",
		"pegjs": "^0.10.0",
		"rimraf": "^3.0.2"
	}
}
